# Azure Service Principal credentials for Key Vault access.
# Copy this file to .env and fill in real values — never commit .env.
#
# To create a service principal:
#   az ad sp create-for-rbac --name emailservices-api --role "Key Vault Secrets User" \
#     --scopes /subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.KeyVault/vaults/kvGPSecrets
#
# When deployed to Azure (ACI, AKS, App Service) with a managed identity assigned,
# these vars can be omitted — DefaultAzureCredential will use the managed identity instead.

AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
