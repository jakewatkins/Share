{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug EmailAgent",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-emailagent",
            "program": "${workspaceFolder}/EmailAgent/bin/Debug/net9.0/EmailAgent.dll",
            "args": [],
            "cwd": "${workspaceFolder}/EmailAgent",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            },
            "logging": {
                "moduleLoad": false
            },
            "justMyCode": false,
            "suppressJITOptimizations": true
        },
        {
            "name": "Debug EmailAgent (Stop at Entry)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-emailagent",
            "program": "${workspaceFolder}/EmailAgent/bin/Debug/net9.0/EmailAgent.dll",
            "args": [],
            "cwd": "${workspaceFolder}/EmailAgent",
            "console": "integratedTerminal",
            "stopAtEntry": true,
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            },
            "logging": {
                "moduleLoad": false
            },
            "justMyCode": false,
            "suppressJITOptimizations": true
        },
        {
            "name": "Attach to EmailAgent",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}