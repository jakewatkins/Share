{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
            {
      "name": ".NET Core Launch (console)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/outlookAgent/bin/Debug/net8.0/outlookAgent.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
            {
            "name": "Debug EmailAgent",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-emailagent",
            "program": "${workspaceFolder}/EmailAgent/bin/Debug/net9.0/EmailAgent.dll",
            "args": [],
            "cwd": "${workspaceFolder}/EmailAgent",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            },
            "logging": {
                "moduleLoad": false
            },
            "justMyCode": false,
            "suppressJITOptimizations": true
        },
        {
            "name": "Debug EmailAgent (Stop at Entry)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-emailagent",
            "program": "${workspaceFolder}/EmailAgent/bin/Debug/net9.0/EmailAgent.dll",
            "args": [],
            "cwd": "${workspaceFolder}/EmailAgent",
            "console": "integratedTerminal",
            "stopAtEntry": true,
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            },
            "logging": {
                "moduleLoad": false
            },
            "justMyCode": false,
            "suppressJITOptimizations": true
        },
        {
            "name": "Attach to EmailAgent",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}