# Environment variables for the docker-compose setup
# Set your hostname here (e.g., fairladyz.local)
HOSTNAME=skyline.local

# N8N Configuration (you can customize these)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme123

# Timezone (adjust as needed)
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York